    <string name="set_folders_after_scan">Папки появятся здѣсь послѣ сканированія медіатеки.</string>
    <string name="set_font">Шрифтъ</string>
    <string name="set_general">Общія</string>
    <string name="set_general_sub">Вкладка при запускѣ, дѣленіе исполнителей</string>
    <string name="set_hero_classic_desc">Картинка затухаетъ въ цвѣтъ фона страницы</string>
    <string name="set_hero_style">Страницы съ картинкой</string>
    <string name="set_hero_vivid_desc">Цвѣтъ картинки перетекаетъ внизъ по страницѣ и потомъ сходитъ на фонъ</string>
    <string name="set_icons">Иконки</string>
